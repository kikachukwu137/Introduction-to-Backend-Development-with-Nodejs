doctype html
html(lang="en")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        link(rel="shortcut icon", href="img/favicon.ico", type="image/png")
        link(rel="stylesheet", href="css/style.css")
        title Natours | Exciting tours for adventurous people


   
    body
        //HEADER 
        // BEM block element modifiers
        header.header 
            nav.nav.nav--tours
                a.nav__el(href='#') All tours
            .header__logo 
                img(src='img/logo-white.png', alt="Natour logo")
                img(src='/img/logo-white.png', alt="Natour logo")

            nav.nav.nav--user 
                //- a.nav__el(href="#") My bookings 
                //- a.nav__el(href="#")
                //-     img.nav__user-img(src="img/user.jpg" alt="User photo")
                //-     span Jonas
                button.nav__el Log in 
                button.nav__el.nav__el--cta Sign up

            //content
            
                        


            //footer
            footer.footer 
                .footer__logo 
                    img(src="img/logo-green.png", alt="Natours logo")
                ul.footer__nav 
                    li: a(href="#") About us 
                    li: a(href="#") Download apps
                    li: a(href="#") Become a guide
                    li: a(href="#") Careers
                    li: a(href="#") Contact

                p.footer__copyright &copy; by JOnas.All rights reserved